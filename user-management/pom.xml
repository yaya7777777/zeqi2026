<!--
  ====================================================================================================================
  📦 Maven 项目对象模型（Project Object Model）
  ====================================================================================================================
  💡 2026-09-04 兼容性修复：
       用户本地 JDK = Eclipse Temurin 24 (JDK24)
       → Spring Boot 2.7 最高只支持 JDK 17，且使用 javax.* 命名空间（JDK 9+ 模块化后已搬到 jakarta.*）
       → 升级到 Spring Boot 3.2 LTS（官方支持 JDK 17~24，命名空间 jakarta.*，完全兼容 JDK24）
       → JDK 字节码级别升到 17（JDK24 向下兼容，完全跑得动）
  ====================================================================================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ============ 1. 继承 Spring Boot 3.2 LTS 父工程（JDK17-24 官方支持 ✅） ========= -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.9</version>   <!-- 3.2.x = Spring Boot 3 的长期支持版，2026-12 才 EOL，JDK 24 完美跑 -->
        <relativePath/>
    </parent>

    <!-- ============ 2. 本项目 GAV 坐标 ========= -->
    <groupId>com.zeqi</groupId>
    <artifactId>user-management</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>user-management</name>
    <description>2026 择栖后端招新题 Part2 · 用户管理系统（Java Spring Boot 3.x 版）</description>

    <!-- ============ 3. JDK 字节码级别：17（JDK24 向下兼容，是 Spring Boot 3 的最低要求） ========= -->
    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <maven.compiler.release>17</maven.compiler.release>   <!-- 保证即使 JDK24 编译，也只生成 JDK17 能跑的字节码 -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <!-- ============ 4. 依赖声明（Spring Boot 3 命名空间全部 jakarta.*） ========= -->
    <dependencies>

        <!-- 🔧 Web 核心（Spring 6 MVC + 内嵌 Tomcat 10 + Jackson） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 🔧 JDBC（JdbcTemplate + HikariCP 连接池） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!-- 🔧 H2 嵌入式数据库 2.2.x（Spring Boot 3 BOM 自带，JDK 17+ 兼容） -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- 🔧 Lombok 代码简化 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 🔧 Validation 参数校验（Spring Boot 3 = Jakarta Validation 3.0，包名 jakarta.validation.*） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ========== 测试依赖（Spring Boot 3 = JUnit 5 Jupiter） ========== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- ============ 5. 构建插件 ========= -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
